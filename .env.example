# ==============================================================================
# SMART ROAD DAMAGE - PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Environment Mode: 'development' | 'production'
ENVIRONMENT=production

# Frontend AI Service Engine Mode: 'mock' (Simulated Engine) | 'api' (Real FastAPI / PyTorch Backend)
VITE_AI_SERVICE_TYPE=mock

# Real AI Model Endpoint URL
VITE_AI_API_URL=http://localhost:8000/api/v1/detections

# Security JWT Signing Secret (Generate using: openssl rand -hex 32)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_HERE

# JWT Signing Algorithm
JWT_ALGORITHM=HS256

# Access Token Expiration (Minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Production Database URL (e.g. postgresql+asyncpg://user:password@host:5432/smartroaddamage)
# SQLite fallback for local dev: sqlite+aiosqlite:///./smart_road_damage.db
DATABASE_URL=sqlite+aiosqlite:///./smart_road_damage.db

# CORS Allowed Origins (Comma-separated origins for production CORS restriction)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://smartroad.city.gov

# Maximum File Upload Size (MB)
MAX_UPLOAD_SIZE_MB=25
